# Copy this file to .env (copy .env.example .env). No API keys: Dinig uses no cloud services.

# Local language model (Ollama). Default 3B; on a slow or full 8GB laptop use the 1.5B fallback.
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://127.0.0.1:11434

# Whisper small for faster-whisper, downloaded once by backend\download_models.py
WHISPER_MODEL_DIR=models/faster-whisper-small
# int8 keeps memory low on 8GB laptops
WHISPER_COMPUTE_TYPE=int8
# 0 = automatic
WHISPER_CPU_THREADS=0

# Reading check method: plan_a (Whisper + difflib) or plan_b (MMS aligner, not built yet)
READING_CHECK=plan_a

# Seconds to wait for Qwen before using pre-written fallbacks
QUIZ_TIMEOUT_SECONDS=8
